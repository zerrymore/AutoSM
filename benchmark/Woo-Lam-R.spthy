/*
  This model originates from the Woo-Lam-Pi model in the Tamarin repo.
  It is a simplified version of the Woo-Lam protocol.

  (1)  A -> B: A
  (2)  B -> A: Nb
  (3)  A -> B: {Nb}Kas
  (4)  B -> S: {A,{Nb}Kas}Kbs
  (5)  S -> B: {Nb}Kbs
*/

theory Woo_Lam_R
begin

builtins: symmetric-encryption


rule Init:
    [ Fr(~kxs)]
  --[ KeyGen($X) ]->
    [ !Ltk(~kxs,$X) ]

    
rule Reveal_Longterm_Key:
    [ !Ltk(~sk,$A)]
  --[ Reveal($A)]->
    [ Out(~sk) ]


//// Protocol rules ////
rule A_to_B_1:
    [ !Ltk(~kas, $A) ]
  -->
    [ Out($A)
    , StateA1($A, $B, ~kas)]


rule B_to_A:
    [ In(a)
    , Fr(~nb)
    , !Ltk(~kbs, $B) ]
  --[ Running_B(a, $B, <'A', 'B', ~nb>) ]->
    [ Out(~nb)
    , StateB1(a, $B, ~kbs, ~nb) ]


// (3)  A -> B: {Nb}Kas
rule A_to_B_2:
    [ In(nb)
    , StateA1($A, $B, ~kas)
    , !Ltk(~kas, $A) ]
  --[ Running_A($A, $B, <'A', 'B', nb>)
    , Secret($A,$B, ~kas) ]->
    [ Out(senc(<'1', nb>,~kas)) ]


// (4)  B -> S: {A,{Nb}Kas}Kbs
rule B_to_S:
    [ In(msg)
    , StateB1(a, $B, ~kbs, ~nb)
    , !Ltk(~kbs, $B) ]
  --[ Secret(a,$B, ~kbs) ]->
    [ Out(senc(<'2', a, msg>, ~kbs))
    , StateB2(a, $B, ~kbs, ~nb, msg) ]


// (5)  S -> B: {Nb}Kbs
rule S_to_B:
    let 
      msg1 = senc(<'1', nb>, ~kas)
      msg2 = senc(<'2', a, msg1>, ~kbs)
    in
    [ In(msg2)
    , !Ltk(~kas, a)
    , !Ltk(~kbs, b) ]
  -->
    [ Out(senc(<'3', nb>, ~kbs)) ]


// 5..   	S 	-> 	B 	:   	{A, B, Nb}shared(B, S)   Receive
rule B_from_S:
    [ In(senc(<'3', ~nb>,~kbs))
    , StateB2(a, $B, ~kbs, ~nb, msg)
    , !Ltk(~kbs, $B) ]
  --[ Commit_B(a, $B, <'A', 'B', ~nb>) ]->
    []



//// Lemmas ////
lemma executability:
    exists-trace
    "Ex A B t #i #j #k.
      Commit_B(A,B,t)@#i
      & Running_A(A,B,t)@#j & #j<#i
      & Running_B(A,B,t)@#k & #k<#j
      & not(Ex #r1. Reveal(A)@#r1)
      & not(Ex #r2. Reveal(B)@#r2)"

      
// check the secrecy of a secret x protected by the long-term key of A and B
lemma Secrecy:
    "not(Ex A B m #i .
        Secret(A, B, m)@ #i
        & (Ex #r. K(m) @ #r)
        & not(Ex #r. Reveal(B)@r)
        & not(Ex #r. Reveal(A)@r))"


// check the authenticity and freshness of the transaction from B's point of view
lemma injectiveagreement_B:
    "All A B t #i.
      Commit_B(A,B,t) @i
      ==> (Ex #j. Running_A(A,B,t)@j & j < i 
            & not (Ex A2 B2 #i2. Commit_B(A2,B2,t)@i2 
            & not (#i2 = #i)))
      | (Ex #r. Reveal(A)@r)
      | (Ex #r. Reveal(B)@r)"


// check the authenticity of the transaction from B's point of view
lemma agreement_B:
    "All A B t #i.
      Commit_B(A,B,t) @i 
      ==> (Ex #j. Running_A(A,B,t) @j 
        & j < i)
      | (Ex #r. Reveal(A)@r)
      | (Ex #r. Reveal(B)@r)"


end